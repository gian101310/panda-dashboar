<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PandaBoxAndLines</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PandaBoxAndLines.cs" />
    <PackageReference Include="cTrader.Automate" Version="1.0.17" />
  </ItemGroup>
  <Target Name="SetAlgoName" BeforeTargets="_ExtractMetadata">
    <PropertyGroup>
      <_AlgoFileName>Panda Box and Lines cTrader.algo</_AlgoFileName>
      <_AlgoFilePath>$(OutDir)$(_AlgoFileName)</_AlgoFilePath>
      <_AlgoMetadataFileName>$(_AlgoFileName).metadata</_AlgoMetadataFileName>
      <_AlgoMetadataFilePath>$(OutDir)$(_AlgoMetadataFileName)</_AlgoMetadataFilePath>
    </PropertyGroup>
  </Target>
</Project>
